{
  "manifest_version": 3,
  "name": "VibeFloat",
  "version": "1.1.0",
  "description": "Nhạc và phim nổi trên Cursor, VS Code và Terminal khi đang code.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.byteoversea.com/*",
    "https://phimapi.com/*",
    "https://*.phimapi.com/*",
    "https://ophim1.com/*",
    "https://*.ophim1.com/*",
    "https://phim.nguonc.com/*",
    "https://*.nguonc.com/*",
    "https://*.streamc.xyz/*",
    "https://phimimg.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.bilibili.com/*",
        "*://*.youku.com/*",
        "*://*.iqiyi.com/*",
        "*://*.netflix.com/*",
        "*://*.v.qq.com/*",
        "*://*.douyin.com/*",
        "*://*.twitch.tv/*",
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}